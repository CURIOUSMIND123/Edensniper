// Breakout Retest for TradingView. Select and copy EVERYTHING in this file, including the next line.
//@version=5
// ============================================================================
// Breakout Retest: NIFTY 5-MINUTE chart, 1-2 trades a day. A STRATEGY script: open the "Strategy Tester"
// tab under the chart to see its results on your own chart, after costs (4 points per trade).
//
// LEVELS: yesterday's high / low, the opening range (9:15-9:30) high / low, and today's swing highs /
//   lows (a candle with 2 lower highs, or 2 higher lows, on each side).
// 1. REAL BREAKOUT: a candle closes through a level (the candle before closed on the other side) and
//    its range is at least 1.5x the average of the 6 candles before it. Highs break up, lows break down.
// 2. PULLBACK: price comes back to within 0.12 x the usual opening range of the level (about 12 Nifty
//    points). If a candle closes back through the level by 0.1 x the range, the breakout has failed.
// 3. ENTRY: after the pullback, a candle closes above the previous candle's high (BUY) or below the
//    previous candle's low (SELL), still on the breakout side of the level.
// 4. RIDE: stop 0.3 x range (about 29 points). After +0.5 x the stop, the stop moves to entry. Then it
//    trails 0.6 x range (about 59 points) behind the best close. Exit at 3:15 at the latest.
// "Usual opening range" = median 9:15-10:45 high-low of the last 20 days (about 98 Nifty points, Oct 2026).
// Up to 3 trades a day, one at a time, entries 9:30-14:30.
// Tested on Nifty 5-minute, Jan 2023 - Oct 2026: 1,482 trades (1.6 a day), 25% won, average win
// +77 / loss -24 points, +1,621 points after costs. Last 90 days: +163. 2025 lost -1,546. Random
// directions with the same entries and exits did as well in about 1 run in 5.
// Reference implementation (same rules): trading-system/research/quant/breakout_retest_test.py
// ============================================================================
strategy("Breakout Retest (Nifty 5m)", "BRKRT", overlay = true, process_orders_on_close = true, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_order, commission_value = 2, initial_capital = 100000, max_lines_count = 500, max_labels_count = 500)

// ---------------- inputs ----------------
G1 = "Rules (tested defaults)"
expandK  = input.float(1.5, "Real breakout: candle range at least this x the last 6 candles' average", step = 0.1, group = G1)
tolK     = input.float(0.12, "Pullback: within this x usual range of the level", step = 0.01, group = G1)
failK    = input.float(0.1, "Failed breakout: close back through the level by this x range", step = 0.01, group = G1)
slK      = input.float(0.3, "Stop, x usual range", step = 0.05, group = G1)
beK      = input.float(0.5, "Move stop to entry after this x the stop in profit (0 = off)", step = 0.1, group = G1)
rideMode = input.string("Trailing stop", "Ride", options = ["Trailing stop", "Hold to 3:15"], group = G1)
trailK   = input.float(0.6, "Trailing distance behind the best close, x usual range", step = 0.05, group = G1)
maxTr    = input.int(3, "Max trades a day", minval = 1, maxval = 10, group = G1)
winSess  = input.session("0930-1430", "New entries only in (IST)", group = G1)
nDays    = input.int(20, "Usual opening range: median of the last N days", minval = 3, maxval = 60, group = G1)
fallback = input.float(0.45, "Under 3 days of chart history: range = this % of price", step = 0.05, group = G1)
G2 = "Display"
showLv   = input.bool(true, "Show the levels being watched", group = G2)
showBox  = input.bool(true, "Show the status and results box", group = G2)

TZ    = "Asia/Kolkata"
GREEN = color.new(#089981, 0)
RED   = color.new(#f23645, 0)
GREY  = color.new(#787b86, 0)
BLUE  = color.new(#2962ff, 0)
fmt(x) => str.tostring(x, "#,##0.##")
pts(x) => str.tostring(x, "+#,##0;-#,##0")

hm     = hour(time, TZ) * 100 + minute(time, TZ)
newDay = dayofmonth(time, TZ) != dayofmonth(time[1], TZ)
inWin  = not na(time(timeframe.period, winSess, TZ))

// ---------------- day state ----------------
var float[] ranges = array.new_float()
var float amHi = na
var float amLo = na
var bool fullDay = false
var float U = na
var float dayHi = na
var float dayLo = na
var int barsToday = 0
var int nTr = 0
// levels: price, direction (+1 = high that can break up, -1 = low that can break down),
// state (0 waiting, 1 broken, 2 failed or used up), pulled back (0/1), and its line
var float[] lvP = array.new_float()
var int[] lvD = array.new_int()
var int[] lvS = array.new_int()
var int[] lvR = array.new_int()
var line[] lvL = array.new_line()

addLevel(float p, int d) =>
    array.push(lvP, p)
    array.push(lvD, d)
    array.push(lvS, 0)
    array.push(lvR, 0)
    array.push(lvL, showLv ? line.new(bar_index, p, bar_index + 1, p, color = color.new(d > 0 ? RED : GREEN, 60), style = line.style_dashed) : na)

if newDay
    if fullDay and not na(amHi)
        array.push(ranges, amHi - amLo)
        if array.size(ranges) > nDays
            array.shift(ranges)
    U := array.size(ranges) >= 3 ? array.median(ranges) : open * fallback / 100
    fullDay := hm == 915
    amHi := na
    amLo := na
    float pdh = dayHi
    float pdl = dayLo
    dayHi := high
    dayLo := low
    barsToday := 0
    nTr := 0
    array.clear(lvP)
    array.clear(lvD)
    array.clear(lvS)
    array.clear(lvR)
    array.clear(lvL)
    if not na(pdh)
        addLevel(pdh, 1)
        addLevel(pdl, -1)
barsToday += 1

// opening range (first three 5-minute candles) and today's 2-candle swings become levels
if barsToday == 3
    addLevel(math.max(high, math.max(high[1], high[2])), 1)
    addLevel(math.min(low, math.min(low[1], low[2])), -1)
if barsToday >= 5
    if high[2] > high[4] and high[2] > high[3] and high[2] > high[1] and high[2] > high
        addLevel(high[2], 1)
    if low[2] < low[4] and low[2] < low[3] and low[2] < low[1] and low[2] < low
        addLevel(low[2], -1)

// ---------------- manage the open trade (time exit, break-even, trailing) ----------------
var float pEntry = na
var float pStop = na
var float pRisk = na
var float pBest = 0.0
var int pSide = 0
var line lStop = na
var int seen = 0
if strategy.position_size != 0 and hm >= 1515
    strategy.close_all(comment = "3:15")
if strategy.closedtrades > seen
    k = strategy.closedtrades - 1
    p = strategy.closedtrades.profit(k)
    label.new(bar_index, strategy.closedtrades.exit_price(k), "EXIT " + pts(p) + " pts", style = label.style_label_left, color = color.new(p >= 0 ? GREEN : RED, 85), textcolor = p >= 0 ? GREEN : RED, size = size.small)
    alert("BRKRT " + syminfo.ticker + " EXIT at " + fmt(strategy.closedtrades.exit_price(k)) + " (" + pts(p) + " pts after costs)", alert.freq_once_per_bar_close)
    line.set_x2(lStop, bar_index)
    seen := strategy.closedtrades
    pSide := 0
if strategy.position_size != 0 and pSide != 0 and hm < 1515
    pBest := math.max(pBest, pSide * (close - pEntry))
    if rideMode == "Trailing stop"
        pStop := pSide > 0 ? math.max(pStop, pEntry + pBest - trailK * U) : math.min(pStop, pEntry - pBest + trailK * U)
    if beK > 0 and pBest >= beK * pRisk
        pStop := pSide > 0 ? math.max(pStop, pEntry) : math.min(pStop, pEntry)
    strategy.exit(pSide > 0 ? "BUY X" : "SELL X", pSide > 0 ? "BUY" : "SELL", stop = pStop)
    line.set_x2(lStop, bar_index)
    lStop := line.new(bar_index, pStop, bar_index + 1, pStop, color = RED, width = 2)

// ---------------- breakouts, pullbacks and entries ----------------
avgRange = (high[1] - low[1] + high[2] - low[2] + high[3] - low[3] + high[4] - low[4] + high[5] - low[5] + high[6] - low[6]) / 6
expandOK = barsToday > 6 and (high - low) >= expandK * avgRange
int sig = 0
float tol = tolK * U
int n = array.size(lvP)
if barstate.isconfirmed and n > 0
    for j = 0 to n - 1
        L = array.get(lvP, j)
        d = array.get(lvD, j)
        s = array.get(lvS, j)
        if showLv and s < 2
            line.set_x2(array.get(lvL, j), bar_index + 1)
        if s == 0
            if (d > 0 ? close > L and close[1] <= L : close < L and close[1] >= L) and expandOK
                array.set(lvS, j, 1)
                array.set(lvR, j, 0)
            continue
        if s != 1
            continue
        if d > 0 ? close < L - failK * U : close > L + failK * U
            array.set(lvS, j, 2)
            continue
        if d > 0 ? low <= L + tol : high >= L - tol
            array.set(lvR, j, 1)
        if array.get(lvR, j) == 1 and sig == 0 and (d > 0 ? close > L and close > high[1] : close < L and close < low[1])
            sig := d
            array.set(lvR, j, 0)

if sig != 0 and strategy.position_size == 0 and inWin and nTr < maxTr
    nTr += 1
    pSide := sig
    pEntry := close
    pRisk := slK * U
    pStop := close - sig * pRisk
    pBest := 0.0
    if sig > 0
        strategy.entry("BUY", strategy.long)
        strategy.exit("BUY X", "BUY", stop = pStop)
    else
        strategy.entry("SELL", strategy.short)
        strategy.exit("SELL X", "SELL", stop = pStop)
    lStop := line.new(bar_index, pStop, bar_index + 1, pStop, color = RED, width = 2)
    txt = (sig > 0 ? "BUY " : "SELL ") + fmt(close) + "\nSTOP " + fmt(pStop) + "\nthen trail"
    label.new(bar_index, close, txt, yloc = sig > 0 ? yloc.belowbar : yloc.abovebar, style = sig > 0 ? label.style_label_up : label.style_label_down, color = sig > 0 ? GREEN : RED, textcolor = color.white, size = size.normal)
    alert("BRKRT " + syminfo.ticker + " " + (sig > 0 ? "BUY" : "SELL") + " at " + fmt(close) + " | STOP " + fmt(pStop) + " | stop moves to entry at " + fmt(close + sig * beK * pRisk) + ", then trails", alert.freq_once_per_bar_close)

// day high / low and the 9:15-10:45 range (for tomorrow)
dayHi := math.max(dayHi, high)
dayLo := math.min(dayLo, low)
if hm >= 915 and hm < 1045
    amHi := na(amHi) ? high : math.max(amHi, high)
    amLo := na(amLo) ? low : math.min(amLo, low)

// ---------------- status and results box ----------------
var table tb = table.new(position.top_right, 2, 7, bgcolor = color.new(color.white, 5), border_color = color.new(GREY, 70), border_width = 1)
putRow(int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = GREY, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_left)

if showBox and barstate.islast
    string msg = ""
    color mc = GREY
    if timeframe.period != "5"
        msg := "Switch the chart to 5 minutes"
        mc := RED
    else if strategy.position_size != 0
        msg := (strategy.position_size > 0 ? "IN BUY from " : "IN SELL from ") + fmt(pEntry) + ". Stop now " + fmt(pStop)
        mc := strategy.position_size > 0 ? GREEN : RED
    else if nTr >= maxTr
        msg := "Done for today (" + str.tostring(maxTr) + " trades)"
    else if not inWin
        msg := "No new entries now (9:30-14:30 only)"
    else
        int waiting = 0
        if array.size(lvP) > 0
            for j = 0 to array.size(lvP) - 1
                if array.get(lvS, j) == 1
                    waiting += 1
        msg := waiting > 0 ? str.tostring(waiting) + " broken level(s): waiting for a pullback and a candle that closes past the previous one" : "Watching levels for a real breakout"
    m = strategy.closedtrades
    float n90 = 0
    float w90 = 0
    float net90 = 0
    cutoff = time - 90 * 86400000
    if m > 0
        for i = 0 to m - 1
            if strategy.closedtrades.exit_time(i) >= cutoff
                n90 += 1
                pr = strategy.closedtrades.profit(i)
                net90 += pr
                if pr > 0
                    w90 += 1
    putRow(0, "Now", msg, mc)
    putRow(1, "Stop / trail", fmt(math.round(slK * U)) + " / " + fmt(math.round(trailK * U)) + " pts", color.black)
    putRow(2, "On this chart", str.tostring(m) + " trades, " + (m > 0 ? str.tostring(math.round(100.0 * strategy.wintrades / m)) : "0") + "% won", color.black)
    putRow(3, "Net after costs", pts(strategy.netprofit) + " pts", strategy.netprofit >= 0 ? GREEN : RED)
    putRow(4, "Last 90 days", str.tostring(n90) + " trades, " + (n90 > 0 ? str.tostring(math.round(100.0 * w90 / n90)) : "0") + "% won, " + pts(net90) + " pts", net90 >= 0 ? GREEN : RED)
    putRow(5, "Avg win / avg loss", (strategy.wintrades > 0 ? pts(strategy.grossprofit / strategy.wintrades) : "-") + " / " + (strategy.losstrades > 0 ? pts(-strategy.grossloss / strategy.losstrades) : "-") + " pts", color.black)
