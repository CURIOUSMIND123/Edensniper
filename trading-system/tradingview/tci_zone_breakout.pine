//@version=5
// TCI Zone Breakout: chart version of trading-system/tci/rules.py
// Use it on the NIFTY 50 index (NSE:NIFTY), 5-minute chart.
// It draws the day's zones, marks the breakout candle ("setup"), the follow-up
// confirmation ("BUY CE/PE"), the stop and target, and the exit.
// It is a decision aid. The Python engine is the reference implementation;
// this script mirrors it using chart OHLC only.
indicator("TCI Zone Breakout", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ---------- inputs ----------
grpR = "Rules"
trigBuf  = input.float(1.0,  "Trigger buffer (pts)", group = grpR)
stopBuf  = input.float(1.0,  "Stop buffer (pts)", group = grpR)
stopMult = input.float(1.0,  "Stop width (x breakout-candle range)", minval = 1.0, step = 0.25, group = grpR,
     tooltip = "1 = stop at the breakout candle's far end. 2 = twice that distance: survives more noise, but each trade risks twice as much.")
minRisk  = input.float(6.0,  "Min risk (pts)", group = grpR)
maxRisk  = input.float(35.0, "Max risk (pts)", group = grpR)
minRR    = input.float(2.0,  "Min reward:risk to next zone", group = grpR)
blueRR   = input.float(3.0,  "Target in R when no zone beyond", group = grpR)
beAtR    = input.float(1.0,  "Move stop to entry after (R)", group = grpR)
mergePts = input.float(10.0, "Merge zones closer than (pts)", group = grpR)
orMins   = input.int(15,     "Opening range (minutes)", group = grpR)
grpT = "Time and limits (IST, HHMM)"
firstEntry = input.int(925,  "First entry", group = grpT)
lastEntry  = input.int(1430, "Last entry", group = grpT)
squareOff  = input.int(1515, "Square-off", group = grpT)
distFrom   = input.int(1400, "Prev-day last-hour window starts", group = grpT)
maxTrades  = input.int(3,    "Max trades per day", group = grpT)
maxLosses  = input.int(2,    "Stop after N losses", group = grpT)
maxAttempt = input.int(2,    "Max attempts per zone and side", group = grpT)
showZones  = input.bool(true, "Show zones", group = "Display")
showPlan   = input.bool(true, "Show CALL / PUT plan table", group = "Display")

// ---------- time helpers ----------
TZ = "Asia/Kolkata"
toMin(hhmm) =>
    int(hhmm / 100) * 60 + hhmm % 100
barMin = hour(time, TZ) * 60 + minute(time, TZ)
tfMin = timeframe.isminutes ? timeframe.multiplier : 0
barEnd = barMin + tfMin
newDay = timeframe.change("D")

// ---------- day state ----------
var float curH = na
var float curL = na
var float curC = na
var float curLH = na
var float curLL = na
var float pdh = na
var float pdl = na
var float pdc = na
var float plh = na
var float pll = na
var float orH = na
var float orL = na
var bool orDone = false
var int trades = 0
var int losses = 0
var attemptKeys = array.new_string()

// pending setup (breakout candle seen, waiting for the follow-up candle)
var string pSide = ""
var float pTrig = na
var float pStop = na
var float pTgt = na
var float pCS = na
var string pZone = ""
var int pBar = na
// open position
var string side = ""
var float entry = na
var float stop = na
var float tgt = na
var float risk = na
var bool atBE = false
var line lStop = na
var line lTgt = na

if newDay
    pdh := curH
    pdl := curL
    pdc := curC
    plh := curLH
    pll := curLL
    curH := high
    curL := low
    curLH := na
    curLL := na
    orH := na
    orL := na
    orDone := false
    trades := 0
    losses := 0
    array.clear(attemptKeys)
    pSide := ""
    side := ""
else
    curH := math.max(nz(curH, high), high)
    curL := math.min(nz(curL, low), low)
curC := close
if barMin >= toMin(distFrom)
    curLH := math.max(nz(curLH, high), high)
    curLL := math.min(nz(curLL, low), low)

// opening range
if barMin < toMin(915) + orMins
    orH := math.max(nz(orH, high), high)
    orL := math.min(nz(orL, low), low)
if not orDone and barEnd >= toMin(915) + orMins
    orDone := true

// ---------- zones (sorted, merged) ----------
zoneName(i) =>
    i == 0 ? "PDH" : i == 1 ? "PDL" : i == 2 ? "PDC" : i == 3 ? "Prev last-hour high" : i == 4 ? "Prev last-hour low" : i == 5 ? "ORH" : "ORL"
rawLv = array.from(pdh, pdl, pdc, plh, pll, orDone ? orH : na, orDone ? orL : na)
lv = array.new_float()
nm = array.new_string()
for i = 0 to 6
    v = array.get(rawLv, i)
    if not na(v)
        array.push(lv, v)
        array.push(nm, zoneName(i))
n = array.size(lv)
if n > 1
    for i = 1 to n - 1
        j = i
        while j > 0 and array.get(lv, j - 1) > array.get(lv, j)
            tv = array.get(lv, j)
            array.set(lv, j, array.get(lv, j - 1))
            array.set(lv, j - 1, tv)
            tn = array.get(nm, j)
            array.set(nm, j, array.get(nm, j - 1))
            array.set(nm, j - 1, tn)
            j -= 1
zl = array.new_float()
zn = array.new_string()
if n > 0
    for i = 0 to n - 1
        v = array.get(lv, i)
        k = array.size(zl) - 1
        if k >= 0 and v - array.get(zl, k) <= mergePts
            array.set(zl, k, (array.get(zl, k) + v) / 2)
            array.set(zn, k, array.get(zn, k) + "/" + array.get(nm, i))
        else
            array.push(zl, v)
            array.push(zn, array.get(nm, i))

// ---------- helpers ----------
attempts(key) =>
    c = 0
    sz = array.size(attemptKeys)
    if sz > 0
        for k = 0 to sz - 1
            if array.get(attemptKeys, k) == key
                c += 1
    c
canOpen(atMin) =>
    side == "" and atMin >= toMin(firstEntry) and atMin <= toMin(lastEntry) and trades < maxTrades and losses < maxLosses
exitLabel(px, why, pts) =>
    label.new(bar_index, px, why + " " + str.tostring(pts / risk, "+0.0;-0.0") + "R", style = label.style_label_left, size = size.small,
         color = pts > 0 ? color.new(color.green, 20) : pts < 0 ? color.new(color.red, 20) : color.new(color.gray, 20), textcolor = color.white)
    alert("TCI EXIT " + side + " " + why + " at index " + str.tostring(px, "#.0"), alert.freq_once_per_bar)

// ---------- exits for an open position (path: green bar O-L-H-C, red bar O-H-L-C) ----------
if side != ""
    isLong = side == "CE"
    green = close >= open
    float px = na
    string why = ""
    if isLong
        if open <= stop
            px := open
            why := "stop"
        else if open >= tgt
            px := open
            why := "target"
        else if green
            px := low <= stop ? stop : high >= tgt ? tgt : na
            why := low <= stop ? "stop" : high >= tgt ? "target" : ""
        else
            px := high >= tgt ? tgt : low <= stop ? stop : na
            why := high >= tgt ? "target" : low <= stop ? "stop" : ""
    else
        if open >= stop
            px := open
            why := "stop"
        else if open <= tgt
            px := open
            why := "target"
        else if green
            px := low <= tgt ? tgt : high >= stop ? stop : na
            why := low <= tgt ? "target" : high >= stop ? "stop" : ""
        else
            px := high >= stop ? stop : low <= tgt ? tgt : na
            why := high >= stop ? "stop" : low <= tgt ? "target" : ""
    if not na(px)
        pts = isLong ? px - entry : entry - px
        label0 = why == "stop" and atBE ? "Breakeven" : why == "stop" ? "Stop" : "Target"
        exitLabel(px, label0, pts)
        losses += pts < 0 ? 1 : 0
        side := ""

// ---------- follow-up candle: entry trigger ----------
if pSide != "" and bar_index == pBar + 1
    hit = pSide == "CE" ? high >= pTrig : low <= pTrig
    if hit and canOpen(barMin)
        gapped = pSide == "CE" ? open >= pTrig : open <= pTrig
        fill = gapped ? open : pTrig
        r = pSide == "CE" ? fill - pStop : pStop - fill
        base = pSide == "CE" ? fill - pCS : pCS - fill
        rew = pSide == "CE" ? pTgt - fill : fill - pTgt
        if r > 0 and base > 0 and rew >= minRR * base * 0.999
            side := pSide
            entry := fill
            stop := pStop
            tgt := pTgt
            risk := r
            atBE := false
            trades += 1
            array.push(attemptKeys, pZone + "|" + pSide)
            label.new(bar_index, fill, "BUY " + side + " @" + str.tostring(fill, "#.0") + "\nSL " + str.tostring(stop, "#.0") + "  T " + str.tostring(tgt, "#.0"),
                 style = side == "CE" ? label.style_label_up : label.style_label_down, yloc = side == "CE" ? yloc.belowbar : yloc.abovebar,
                 color = side == "CE" ? color.new(color.teal, 0) : color.new(color.maroon, 0), textcolor = color.white, size = size.small)
            alert("TCI ENTRY BUY " + side + " at index " + str.tostring(fill, "#.0") + " SL " + str.tostring(stop, "#.0") + " T " + str.tostring(tgt, "#.0"), alert.freq_once_per_bar)
            lStop := line.new(bar_index, stop, bar_index + 1, stop, color = color.red, width = 2)
            lTgt := line.new(bar_index, tgt, bar_index + 1, tgt, color = color.green, width = 2)
            // rest of the bar after the fill
            green2 = close >= open
            stopNow = side == "CE" ? (gapped or not green2 ? low <= stop : close <= stop) : (gapped or green2 ? high >= stop : close >= stop)
            if stopNow
                exitLabel(stop, "Stop", -risk)
                losses += 1
                side := ""
    pSide := ""

// ---------- bar close: square-off, breakeven, new setups ----------
if barstate.isconfirmed
    if side != ""
        line.set_x2(lStop, bar_index)
        line.set_x2(lTgt, bar_index)
        if barEnd >= toMin(squareOff)
            pts = side == "CE" ? close - entry : entry - close
            exitLabel(close, "Square-off", pts)
            losses += pts < 0 ? 1 : 0
            side := ""
        else if not atBE
            mv = side == "CE" ? high - entry : entry - low
            if mv >= beAtR * risk
                stop := entry
                atBE := true
                line.set_y1(lStop, entry)
                line.set_y2(lStop, entry)
    nz_ = array.size(zl)
    if side == "" and pSide == "" and canOpen(barEnd) and nz_ > 0
        ref = math.min(open, nz(close[1], open))
        refHi = math.max(open, nz(close[1], open))
        setSide = ""
        zname = ""
        if close > open
            for i = 0 to nz_ - 1
                v = array.get(zl, i)
                if ref <= v and v < close
                    zname := array.get(zn, i)
                    setSide := "CE"
        else if close < open
            for i = nz_ - 1 to 0
                v = array.get(zl, i)
                if close < v and v <= refHi
                    zname := array.get(zn, i)
                    setSide := "PE"
        if setSide != ""
            t = setSide == "CE" ? high + trigBuf : low - trigBuf
            cs = setSide == "CE" ? low - stopBuf : high + stopBuf
            r = math.abs(t - cs)
            s = setSide == "CE" ? t - stopMult * r : t + stopMult * r
            float nxt = na
            for i = 0 to nz_ - 1
                v = array.get(zl, i)
                if setSide == "CE" and v > t and (na(nxt) or v < nxt)
                    nxt := v
                if setSide == "PE" and v < t and (na(nxt) or v > nxt)
                    nxt := v
            tg = na(nxt) ? (setSide == "CE" ? t + blueRR * r : t - blueRR * r) : nxt
            ok = r >= minRisk and r <= maxRisk and math.abs(tg - t) >= minRR * r and attempts(zname + "|" + setSide) < maxAttempt
            if ok
                pSide := setSide
                pTrig := t
                pStop := s
                pTgt := tg
                pCS := cs
                pZone := zname
                pBar := bar_index
                label.new(bar_index, setSide == "CE" ? high : low, setSide + " setup: " + zname + "\nconfirm " + str.tostring(t, "#.0"),
                     style = setSide == "CE" ? label.style_label_down : label.style_label_up, size = size.tiny,
                     color = color.new(color.orange, 30), textcolor = color.black)
                alert("TCI SETUP " + setSide + " " + zname + ": buy if next candle crosses " + str.tostring(t, "#.0") + " SL " + str.tostring(s, "#.0") + " T " + str.tostring(tg, "#.0"), alert.freq_once_per_bar_close)

// ---------- both directions: CALL above / PUT below (like his morning plan) ----------
var table planTbl = table.new(position.top_right, 2, 3, bgcolor = color.new(color.white, 15), border_color = color.new(color.gray, 70), border_width = 1)
if showPlan and barstate.islast
    float upZ = na
    float upT = na
    string upN = ""
    float dnZ = na
    float dnT = na
    string dnN = ""
    nzl = array.size(zl)
    if nzl > 0
        for i = 0 to nzl - 1
            v = array.get(zl, i)
            if v > close and na(upZ)
                upZ := v
                upN := array.get(zn, i)
            else if v > close and na(upT)
                upT := v
        for i = nzl - 1 to 0
            v = array.get(zl, i)
            if v < close and na(dnZ)
                dnZ := v
                dnN := array.get(zn, i)
            else if v < close and na(dnT)
                dnT := v
    table.cell(planTbl, 0, 0, "Side", text_color = color.black, text_size = size.small)
    table.cell(planTbl, 1, 0, "Plan (" + str.tostring(tfMin) + "-min candle close, then follow-up)", text_color = color.black, text_size = size.small)
    table.cell(planTbl, 0, 1, "CALL (CE)", text_color = color.teal, text_size = size.small)
    table.cell(planTbl, 1, 1, na(upZ) ? "no zone above" : "close above " + str.tostring(upZ, "#") + " (" + upN + ")  ->  T " + (na(upT) ? str.tostring(blueRR) + "x range" : str.tostring(upT, "#")),
         text_color = color.black, text_size = size.small, text_halign = text.align_left)
    table.cell(planTbl, 0, 2, "PUT (PE)", text_color = color.maroon, text_size = size.small)
    table.cell(planTbl, 1, 2, na(dnZ) ? "no zone below" : "close below " + str.tostring(dnZ, "#") + " (" + dnN + ")  ->  T " + (na(dnT) ? str.tostring(blueRR) + "x range" : str.tostring(dnT, "#")),
         text_color = color.black, text_size = size.small, text_halign = text.align_left)

// ---------- plots ----------
plot(showZones ? pdh : na, "PDH", color.new(color.blue, 0), 1, plot.style_linebr)
plot(showZones ? pdl : na, "PDL", color.new(color.blue, 0), 1, plot.style_linebr)
plot(showZones ? pdc : na, "PDC", color.new(color.gray, 0), 1, plot.style_linebr)
plot(showZones ? plh : na, "Prev last-hour high", color.new(color.purple, 30), 1, plot.style_linebr)
plot(showZones ? pll : na, "Prev last-hour low", color.new(color.purple, 30), 1, plot.style_linebr)
plot(showZones and orDone ? orH : na, "ORH", color.new(color.orange, 0), 1, plot.style_linebr)
plot(showZones and orDone ? orL : na, "ORL", color.new(color.orange, 0), 1, plot.style_linebr)
bgcolor(trades >= maxTrades or losses >= maxLosses ? color.new(color.gray, 92) : na, title = "Day limit reached")
