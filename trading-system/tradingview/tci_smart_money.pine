// TCI Smart Money for TradingView. Select and copy EVERYTHING in this file, including the next line.
//@version=5
// ============================================================================
// TCI Smart Money: liquidity map + trap / retest signals for the NIFTY index, 5-minute chart
//
// LIQUIDITY MAP (always on, also before the open): the nearest untouched levels above and below price,
// where stop-losses gather: highs / lows of the last 5 sessions, previous week high / low, major swing
// highs / lows (EQH / EQL when equal), opening range, previous close, OI walls you type in.
// SIGNALS:
//   TRAP   - price runs through a liquidity level (takes the stops) and closes back with a rejection
//            candle (pin bar, engulfing or a strong close) -> trade the other way
//   RETEST - a level broken in the last hour is retested and holds -> trade the break direction
//   (BREAK - strong candle through a level; off by default, it lost money in the test)
// Entry only when one of the next 2 candles breaks the signal candle (his follow-up rule).
// No new entries 11:00-14:00 (mid-day chop: the losing trades clustered there).
// SL just beyond the signal candle / swept level (15-40 points). T1 = first liquidity at least 2 x SL away
// (1:2 or better). MAX = the next liquidity after T1. His management: book half at 1:1 and move the SL to
// entry; after T1 the SL trails 2 x ATR behind the best price until MAX, the trail, or 15:15.
// Reference implementation (same rules, backtested): trading-system/tci/smartmoney.py
// ============================================================================
indicator("TCI Smart Money", "TCI SM", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ---------------- inputs ----------------
G1 = "Signals"
useTrap    = input.bool(true, "TRAP: stop-hunt through a level, then rejection", group = G1)
useRetest  = input.bool(true, "RETEST: broken level retested and held", group = G1)
useBreak   = input.bool(false, "BREAK: strong candle through a level (lost money in the test)", group = G1)
confirmN   = input.int(2, "Candles allowed for the follow-up break", minval = 1, maxval = 3, group = G1)
G2 = "Risk and targets (index points)"
minSL      = input.float(15.0, "Minimum SL", group = G2)
maxSL      = input.float(40.0, "Maximum SL (skip the trade if more)", group = G2)
rrMin      = input.float(2.0, "T1 = first liquidity at least this many times the SL (2 = 1:2)", step = 0.5, group = G2)
minT1      = input.float(0.0, "Also at least this many points (0 = off)", group = G2)
halfAtR    = input.float(1.0, "Book half at this many R and move SL to entry (0 = off)", step = 0.25, group = G2)
trailATR   = input.float(2.0, "After T1, trail the SL this many ATR behind the best price", step = 0.25, group = G2)
exitAtT1   = input.bool(false, "Exit fully at T1 instead of trailing to MAX", group = G2)
strikeStep = input.int(50, "Option strike step (NIFTY 50, SENSEX 100)", group = G2)
itmSteps   = input.int(2, "Suggested strike: strikes in-the-money", minval = 0, maxval = 5, group = G2)
G3 = "Liquidity"
majorLen   = input.int(6, "Major swing strength (candles each side)", minval = 3, maxval = 12, group = G3)
sessKept   = input.int(5, "Sessions of highs / lows to track", minval = 1, maxval = 5, group = G3)
maxSwings  = input.int(10, "Swing levels kept per side", minval = 2, maxval = 20, group = G3)
eqTol      = input.float(0.25, "Equal highs / lows tolerance (x ATR)", step = 0.05, group = G3)
sweepMin   = input.float(2.0, "A level is taken when price trades beyond it by (pts)", group = G3)
rejFrac    = input.float(0.4, "Strong close: within this part of the candle's range", step = 0.05, group = G3)
pinBody    = input.float(2.0, "Pin bar: wick >= x body", step = 0.25, group = G3)
pinRange   = input.float(0.5, "Pin bar: wick >= x candle range", step = 0.05, group = G3)
brkBody    = input.float(0.5, "Break candle: body >= x range", step = 0.05, group = G3)
brkRange   = input.float(0.8, "Break candle: range >= x ATR", step = 0.1, group = G3)
retestBars = input.int(12, "Retest allowed within (candles)", minval = 3, maxval = 30, group = G3)
retestTol  = input.float(0.3, "Retest tolerance (x ATR)", step = 0.05, group = G3)
orMins     = input.int(15, "Opening range (minutes)", group = G3)
G4 = "Session (IST, HHMM)"
firstEntry = input.int(920, "First entry", group = G4)
lastEntry  = input.int(1445, "Last entry", group = G4)
usePause   = input.bool(true, "Pause new entries in the mid-day chop", group = G4,
     tooltip = "In the test, entries between 11:00 and 14:00 won 12% of the time and lost money in both halves of the data.")
pauseFrom  = input.int(1100, "Pause from", group = G4)
pauseTo    = input.int(1400, "Pause until", group = G4)
squareOff  = input.int(1515, "Square-off", group = G4)
maxTrades  = input.int(4, "Max trades per day", group = G4)
maxLosses  = input.int(2, "Stop after N losses", group = G4)
G5 = "Smart money context (type in from the option chain each morning)"
pcrVal     = input.float(0.0, "PCR (0 = not set)", step = 0.01, group = G5)
ceWall     = input.float(0.0, "Strike with highest CALL OI = resistance (0 = not set)", group = G5)
peWall     = input.float(0.0, "Strike with highest PUT OI = support (0 = not set)", group = G5)
G6 = "Display"
mapCount   = input.int(3, "Liquidity levels to show above and below price", minval = 0, maxval = 6, group = G6)
showPlan   = input.bool(true, "Show the plan table (levels, plan, trade, scorecard)", group = G6)
showExits  = input.bool(true, "Mark exits (small text)", group = G6)
showSetups = input.bool(false, "Show setups before the follow-up confirms", group = G6)

// ---------------- basics ----------------
TZ = "Asia/Kolkata"
toMin(hhmm) =>
    int(hhmm / 100) * 60 + hhmm % 100
barMin = hour(time, TZ) * 60 + minute(time, TZ)
tfMin = timeframe.isminutes ? timeframe.multiplier : 5
barEnd = barMin + tfMin
newDay = timeframe.change("D")
newWeek = timeframe.change("W")
atr = ta.atr(14)
atrP = nz(atr[1], atr)
ph = ta.pivothigh(high, majorLen, majorLen)
pl = ta.pivotlow(low, majorLen, majorLen)
fmt(x) =>
    str.tostring(x, "#")
dayName(d) =>
    d == dayofweek.monday ? "Mon" : d == dayofweek.tuesday ? "Tue" : d == dayofweek.wednesday ? "Wed" : d == dayofweek.thursday ? "Thu" : d == dayofweek.friday ? "Fri" : "Sat"

// candle rejection (computed every candle)
rngC = high - low
bodyC = math.abs(close - open)
upW = high - math.max(open, close)
loW = math.min(open, close) - low
rejB = rngC <= 0 ? "" : loW >= pinBody * bodyC and loW >= pinRange * rngC ? "pin bar" : close > open and close[1] < open[1] and close >= open[1] and open <= close[1] ? "engulfing" : close >= high - rejFrac * rngC ? "strong close" : ""
rejS = rngC <= 0 ? "" : upW >= pinBody * bodyC and upW >= pinRange * rngC ? "pin bar" : close < open and close[1] > open[1] and close <= open[1] and open >= close[1] ? "engulfing" : close <= low + rejFrac * rngC ? "strong close" : ""

// ---------------- state ----------------
// finished sessions (newest last): high, low, close, weekday, taken flags
var float[] sH = array.new_float()
var float[] sL = array.new_float()
var float[] sC = array.new_float()
var int[] sDow = array.new_int()
var bool[] sHT = array.new_bool()
var bool[] sLT = array.new_bool()
var float curH = na
var float curL = na
var float curC = na
var int curDow = na
var float wkH = na
var float wkL = na
var float pwH = na
var float pwL = na
var bool pwHT = false
var bool pwLT = false
// liquidity pool. kind: 1 session high, 2 session low, 3 prev close, 4 PWH, 5 PWL, 6 ORH, 7 ORL, 8 swing high, 9 swing low
var float[] pP = array.new_float()
var int[] pK = array.new_int()
var int[] pB = array.new_int()
var string[] pN = array.new_string()
// broken levels waiting for a retest
var float[] bP = array.new_float()
var int[] bD = array.new_int()
var int[] bBar = array.new_int()
var string[] bN = array.new_string()
var bool orDone = false
var float orH = na
var float orL = na
var int trend = 0
var float lastSH = na
var float lastSL = na
var int dayTrades = 0
var int dayLosses = 0
// pending signal / open trade
var int pSide = 0
var float pTrig = na
var float pSLs = na
var int pBar = na
var string pSetup = ""
var string pDetail = ""
var int posSide = 0
var float posEntry = na
var float posSL = na
var float posSL0 = na
var float posT1 = na
var float posMax = na
var float posBest = na
var bool t1Hit = false
var bool halfDone = false
var float halfPx = na
var string posSetup = ""
var int exitBar = na
var float exitSL = na
var float exitT1 = na
var float exitMax = na
var bool exitT1Hit = false
// scorecard
var int nTrades = 0
var int nWins = 0
var float sumPts = 0.0
var string lastMsg = "No trade yet"

sideOf(k) =>
    k == 1 or k == 4 or k == 6 or k == 8 ? 1 : k == 3 ? 0 : -1

// ---------------- new week / new day: rebuild the session part of the pool ----------------
if newWeek
    pwH := wkH
    pwL := wkL
    pwHT := false
    pwLT := false
    wkH := high
    wkL := low
else
    wkH := math.max(nz(wkH, high), high)
    wkL := math.min(nz(wkL, low), low)

if newDay
    if posSide != 0
        r0 = posSide * ((halfDone ? (halfPx + close[1]) / 2 : close[1]) - posEntry)
        nTrades += 1
        nWins += r0 > 0 ? 1 : 0
        sumPts += r0
        posSide := 0
        halfDone := false
    pSide := 0
    if not na(curH)
        array.push(sH, curH)
        array.push(sL, curL)
        array.push(sC, curC)
        array.push(sDow, curDow)
        array.push(sHT, false)
        array.push(sLT, false)
        if array.size(sH) > sessKept
            array.shift(sH)
            array.shift(sL)
            array.shift(sC)
            array.shift(sDow)
            array.shift(sHT)
            array.shift(sLT)
    // drop everything except swing levels, then add the untouched session levels
    if array.size(pP) > 0
        for i = array.size(pP) - 1 to 0
            if array.get(pK, i) < 8
                array.remove(pP, i)
                array.remove(pK, i)
                array.remove(pB, i)
                array.remove(pN, i)
    ns = array.size(sH)
    if ns > 0
        for i = 0 to ns - 1
            age = ns - i
            nmH = age == 1 ? "PDH" : dayName(array.get(sDow, i)) + " high"
            nmL = age == 1 ? "PDL" : dayName(array.get(sDow, i)) + " low"
            if not array.get(sHT, i)
                array.push(pP, array.get(sH, i))
                array.push(pK, 1)
                array.push(pB, bar_index - 1)
                array.push(pN, nmH)
            if not array.get(sLT, i)
                array.push(pP, array.get(sL, i))
                array.push(pK, 2)
                array.push(pB, bar_index - 1)
                array.push(pN, nmL)
        array.push(pP, array.get(sC, ns - 1))
        array.push(pK, 3)
        array.push(pB, bar_index - 1)
        array.push(pN, "PDC")
    if not na(pwH) and not pwHT
        array.push(pP, pwH)
        array.push(pK, 4)
        array.push(pB, bar_index - 1)
        array.push(pN, "PWH")
    if not na(pwL) and not pwLT
        array.push(pP, pwL)
        array.push(pK, 5)
        array.push(pB, bar_index - 1)
        array.push(pN, "PWL")
    curH := high
    curL := low
    orDone := false
    orH := na
    orL := na
    dayTrades := 0
    dayLosses := 0
else
    curH := math.max(nz(curH, high), high)
    curL := math.min(nz(curL, low), low)
curC := close
curDow := dayofweek(time, TZ)

canOpen(atMin) =>
    paused = usePause and atMin >= toMin(pauseFrom) and atMin < toMin(pauseTo)
    posSide == 0 and not paused and atMin >= toMin(firstEntry) and atMin <= toMin(lastEntry) and dayTrades < maxTrades and dayLosses < maxLosses

// distances to the liquidity beyond the entry -> [T1, MAX]
targets(side, fp, dist) =>
    d = array.new_float()
    n = array.size(pP)
    if n > 0
        for i = 0 to n - 1
            x = side * (array.get(pP, i) - fp)
            if x > 0.5
                array.push(d, x)
    if ceWall > 0 and side == 1 and ceWall - fp > 0.5
        array.push(d, ceWall - fp)
    if peWall > 0 and side == -1 and fp - peWall > 0.5
        array.push(d, fp - peWall)
    array.sort(d, order.ascending)
    need = math.max(minT1, rrMin * dist)
    float d1 = math.max(need, 2 * dist)
    float dMax = na
    if array.size(d) > 0
        for i = 0 to array.size(d) - 1
            if array.get(d, i) >= need
                d1 := array.get(d, i)
                break
        for i = 0 to array.size(d) - 1
            if array.get(d, i) - d1 >= 25
                dMax := array.get(d, i)
                break
    if na(dMax)
        dMax := 2 * d1
    [fp + side * d1, fp + side * dMax]

strikeFor(side, px) =>
    side == 1 ? math.floor(px / strikeStep) * strikeStep - math.max(itmSteps - 1, 0) * strikeStep : math.ceil(px / strikeStep) * strikeStep + math.max(itmSteps - 1, 0) * strikeStep

// ---------------- intrabar: entry trigger and exits (green candle O-L-H-C, red O-H-L-C) ----------------
green = close >= open
for k = 0 to 3
    px = k == 0 ? open : k == 3 ? close : (k == 1) == green ? low : high
    gap = k == 0
    bool doClose = false
    float closePx = na
    string closeWhy = ""
    if posSide != 0
        isBuy = posSide == 1
        if isBuy ? px <= posSL : px >= posSL
            doClose := true
            closePx := gap ? px : posSL
            closeWhy := posSL == posSL0 ? "SL" : t1Hit ? "Trail" : "BE"
        else
            if halfAtR > 0 and not halfDone
                lvlH = posEntry + posSide * halfAtR * math.abs(posEntry - posSL0)
                if isBuy ? px >= lvlH : px <= lvlH
                    halfDone := true
                    halfPx := gap ? px : lvlH
                    posSL := isBuy ? math.max(posSL, posEntry) : math.min(posSL, posEntry)
                    if showExits
                        label.new(bar_index, halfPx, "half booked, SL to entry", style = label.style_none, size = size.tiny, textcolor = color.green)
                    alert("TCI book HALF at " + fmt(halfPx) + ". Move SL to entry " + fmt(posEntry), alert.freq_once_per_bar)
            tgt = t1Hit and not exitAtT1 ? posMax : posT1
            if isBuy ? px >= tgt : px <= tgt
                fillX = gap ? px : tgt
                if not exitAtT1 and not t1Hit
                    t1Hit := true
                    posSL := isBuy ? math.max(posSL, posEntry) : math.min(posSL, posEntry)
                    if showExits
                        label.new(bar_index, fillX, "T1 hit, trailing", style = label.style_none, size = size.tiny, textcolor = color.green)
                    alert("TCI T1 hit at " + fmt(fillX) + ". SL now " + fmt(posSL) + ", trailing to MAX " + fmt(posMax), alert.freq_once_per_bar)
                else
                    doClose := true
                    closePx := fillX
                    closeWhy := t1Hit ? "MAX" : "T1"
    else if pSide != 0 and bar_index > pBar and bar_index <= pBar + confirmN and canOpen(barMin)
        if pSide == 1 ? px >= pTrig : px <= pTrig
            fillPx = gap ? px : pTrig
            side = pSide
            pSide := 0
            dist = math.max(minSL, side * (fillPx - pSLs))
            if dist > maxSL
                lastMsg := "Skipped " + pSetup + ": SL would be " + fmt(dist) + " pts"
            else
                [t1, tMax] = targets(side, fillPx, dist)
                posSide := side
                posEntry := fillPx
                posSL := fillPx - side * dist
                posSL0 := posSL
                posT1 := t1
                posMax := tMax
                posBest := fillPx
                t1Hit := false
                halfDone := false
                posSetup := pSetup
                dayTrades += 1
                opt = fmt(strikeFor(side, fillPx)) + (side == 1 ? " CE" : " PE")
                info = (side == 1 ? "BUY " : "SELL ") + fmt(fillPx) + "\nSL " + fmt(posSL) + " (" + fmt(dist) + " pts)\nT1 " + fmt(t1) + " (" + fmt(math.abs(t1 - fillPx)) + " pts)\nMAX " + fmt(tMax) + " (" + fmt(math.abs(tMax - fillPx)) + " pts)\n" + pSetup + ": " + pDetail + "\nOption idea: " + opt
                label.new(bar_index, fillPx, (side == 1 ? "BUY  " : "SELL  ") + fmt(fillPx), yloc = side == 1 ? yloc.belowbar : yloc.abovebar,
                     style = side == 1 ? label.style_label_up : label.style_label_down, size = size.normal, textcolor = color.white,
                     color = side == 1 ? color.new(#089981, 0) : color.new(#F23645, 0), tooltip = info)
                lastMsg := info
                alert("TCI " + info, alert.freq_once_per_bar)
    if doClose
        pts = posSide * ((halfDone ? (halfPx + closePx) / 2 : closePx) - posEntry)
        nTrades += 1
        nWins += pts > 0 ? 1 : 0
        sumPts += pts
        dayLosses += pts < 0 ? 1 : 0
        exitBar := bar_index
        exitSL := posSL
        exitT1 := posT1
        exitMax := posMax
        exitT1Hit := t1Hit
        if showExits
            label.new(bar_index, closePx, closeWhy + " " + str.tostring(pts, "+#;-#") + " pts", style = label.style_none, size = size.tiny,
                 textcolor = pts > 0 ? color.green : pts < 0 ? color.red : color.gray)
        alert("TCI EXIT " + (posSide == 1 ? "BUY" : "SELL") + " " + closeWhy + " at " + fmt(closePx) + " (" + str.tostring(pts, "+#;-#") + " pts)", alert.freq_once_per_bar)
        lastMsg := "Last trade: " + closeWhy + " " + str.tostring(pts, "+#;-#") + " pts"
        posSide := 0
        t1Hit := false
        halfDone := false

// ---------------- bar close: opening range, trade management, signals, liquidity update ----------------
if barstate.isconfirmed
    if not orDone
        orH := math.max(nz(orH, high), high)
        orL := math.min(nz(orL, low), low)
        if barEnd >= toMin(915) + orMins
            orDone := true
            array.push(pP, orH)
            array.push(pK, 6)
            array.push(pB, bar_index)
            array.push(pN, "ORH")
            array.push(pP, orL)
            array.push(pK, 7)
            array.push(pB, bar_index)
            array.push(pN, "ORL")
    if posSide != 0
        if barEnd >= toMin(squareOff)
            pts = posSide * ((halfDone ? (halfPx + close) / 2 : close) - posEntry)
            nTrades += 1
            nWins += pts > 0 ? 1 : 0
            sumPts += pts
            dayLosses += pts < 0 ? 1 : 0
            exitBar := bar_index
            exitSL := posSL
            exitT1 := posT1
            exitMax := posMax
            exitT1Hit := t1Hit
            if showExits
                label.new(bar_index, close, "3:15 exit " + str.tostring(pts, "+#;-#") + " pts", style = label.style_none, size = size.tiny,
                     textcolor = pts > 0 ? color.green : pts < 0 ? color.red : color.gray)
            lastMsg := "Squared off " + str.tostring(pts, "+#;-#") + " pts"
            posSide := 0
            t1Hit := false
            halfDone := false
        else
            posBest := posSide == 1 ? math.max(posBest, high) : math.min(posBest, low)
            risk0 = math.abs(posEntry - posSL0)
            if posSL == posSL0 and posSide * (posBest - posEntry) >= risk0
                posSL := posEntry
            if t1Hit and not exitAtT1
                trail = posBest - posSide * trailATR * atr
                posSL := posSide == 1 ? math.max(posSL, trail) : math.min(posSL, trail)
    if pSide != 0 and bar_index >= pBar + confirmN
        pSide := 0

    // ---- detect (pool as it was before this candle)
    int sSide = 0
    string sSetup = ""
    string sDetail = ""
    float sSL = na
    n = array.size(pP)
    if useTrap and n > 0
        float best = na
        string bn = ""
        if rejB != ""
            for i = 0 to n - 1
                v = array.get(pP, i)
                if sideOf(array.get(pK, i)) == -1 and low < v - sweepMin and close > v and (na(best) or v < best)
                    best := v
                    bn := array.get(pN, i)
            if not na(best)
                sSide := 1
                sSetup := "TRAP"
                sDetail := "swept " + bn + " " + fmt(best) + ", " + rejB
                sSL := low - 2
        if sSide == 0 and rejS != ""
            best := na
            for i = 0 to n - 1
                v = array.get(pP, i)
                if sideOf(array.get(pK, i)) == 1 and high > v + sweepMin and close < v and (na(best) or v > best)
                    best := v
                    bn := array.get(pN, i)
            if not na(best)
                sSide := -1
                sSetup := "TRAP"
                sDetail := "swept " + bn + " " + fmt(best) + ", " + rejS
                sSL := high + 2
    nb = array.size(bP)
    if sSide == 0 and useRetest and nb > 0
        tol = retestTol * atrP
        for i = nb - 1 to 0
            age = bar_index - array.get(bBar, i)
            if age <= retestBars and age >= 2
                v = array.get(bP, i)
                dr = array.get(bD, i)
                if dr == 1 and low <= v + tol and close > v and rejB != ""
                    sSide := 1
                    sSetup := "RETEST"
                    sDetail := "retest of " + array.get(bN, i) + " " + fmt(v) + " held"
                    sSL := math.min(low, v - tol) - 2
                else if dr == -1 and high >= v - tol and close < v and rejS != ""
                    sSide := -1
                    sSetup := "RETEST"
                    sDetail := "retest of " + array.get(bN, i) + " " + fmt(v) + " held"
                    sSL := math.max(high, v + tol) + 2
                if sSide != 0
                    array.remove(bP, i)
                    array.remove(bD, i)
                    array.remove(bBar, i)
                    array.remove(bN, i)
                    break
    if sSide == 0 and useBreak and n > 0 and rngC > 0 and bodyC >= brkBody * rngC and rngC >= brkRange * atrP
        float best = na
        string bn = ""
        refLo = math.min(open, nz(close[1], open))
        refHi = math.max(open, nz(close[1], open))
        for i = 0 to n - 1
            v = array.get(pP, i)
            sd = sideOf(array.get(pK, i))
            if close > open and sd >= 0 and refLo <= v and v < close and (na(best) or v > best)
                best := v
                bn := array.get(pN, i)
            if close < open and sd <= 0 and close < v and v <= refHi and (na(best) or v < best)
                best := v
                bn := array.get(pN, i)
        if not na(best)
            sSide := close > open ? 1 : -1
            sSetup := "BREAK"
            sDetail := (sSide == 1 ? "broke above " : "broke below ") + bn + " " + fmt(best)
            sSL := sSide == 1 ? low - 2 : high + 2

    // ---- update the pool with this candle: breaks (for retests), taken levels, new swings
    if array.size(pP) > 0
        for i = array.size(pP) - 1 to 0
            if bar_index > array.get(pB, i)
                v = array.get(pP, i)
                sd = sideOf(array.get(pK, i))
                if sd >= 0 and close > v + sweepMin and close[1] <= v
                    array.push(bP, v)
                    array.push(bD, 1)
                    array.push(bBar, bar_index)
                    array.push(bN, array.get(pN, i))
                if sd <= 0 and close < v - sweepMin and close[1] >= v
                    array.push(bP, v)
                    array.push(bD, -1)
                    array.push(bBar, bar_index)
                    array.push(bN, array.get(pN, i))
                taken = sd == 1 ? high > v + sweepMin : sd == -1 ? low < v - sweepMin : low < v and v < high
                if taken
                    array.remove(pP, i)
                    array.remove(pK, i)
                    array.remove(pB, i)
                    array.remove(pN, i)
    if array.size(bP) > 0
        for i = array.size(bP) - 1 to 0
            if bar_index - array.get(bBar, i) > retestBars
                array.remove(bP, i)
                array.remove(bD, i)
                array.remove(bBar, i)
                array.remove(bN, i)
    // session / week levels taken since they formed
    if array.size(sH) > 0
        for i = 0 to array.size(sH) - 1
            if high > array.get(sH, i) + sweepMin
                array.set(sHT, i, true)
            if low < array.get(sL, i) - sweepMin
                array.set(sLT, i, true)
    if not na(pwH) and high > pwH + sweepMin
        pwHT := true
    if not na(pwL) and low < pwL - sweepMin
        pwLT := true
    if not na(lastSH) and close > lastSH
        trend := 1
    if not na(lastSL) and close < lastSL
        trend := -1
    if not na(ph)
        eq = false
        cnt = 0
        if array.size(pP) > 0
            for i = 0 to array.size(pP) - 1
                if sideOf(array.get(pK, i)) == 1 and math.abs(array.get(pP, i) - ph) <= eqTol * atrP
                    eq := true
                if array.get(pK, i) == 8
                    cnt += 1
        array.push(pP, ph)
        array.push(pK, 8)
        array.push(pB, bar_index)
        array.push(pN, eq ? "equal highs" : "swing high")
        lastSH := ph
        if cnt + 1 > maxSwings
            for i = 0 to array.size(pP) - 1
                if array.get(pK, i) == 8
                    array.remove(pP, i)
                    array.remove(pK, i)
                    array.remove(pB, i)
                    array.remove(pN, i)
                    break
    if not na(pl)
        eq = false
        cnt = 0
        if array.size(pP) > 0
            for i = 0 to array.size(pP) - 1
                if sideOf(array.get(pK, i)) == -1 and math.abs(array.get(pP, i) - pl) <= eqTol * atrP
                    eq := true
                if array.get(pK, i) == 9
                    cnt += 1
        array.push(pP, pl)
        array.push(pK, 9)
        array.push(pB, bar_index)
        array.push(pN, eq ? "equal lows" : "swing low")
        lastSL := pl
        if cnt + 1 > maxSwings
            for i = 0 to array.size(pP) - 1
                if array.get(pK, i) == 9
                    array.remove(pP, i)
                    array.remove(pK, i)
                    array.remove(pB, i)
                    array.remove(pN, i)
                    break

    // ---- arm the signal (entry needs the follow-up break)
    if sSide != 0 and posSide == 0 and pSide == 0 and canOpen(barEnd)
        pSide := sSide
        pTrig := sSide == 1 ? high + 1 : low - 1
        pSLs := sSL
        pBar := bar_index
        pSetup := sSetup
        pDetail := sDetail
        if showSetups
            label.new(bar_index, sSide == 1 ? low : high, (sSide == 1 ? "BUY setup: " : "SELL setup: ") + sDetail + "\nenter beyond " + fmt(pTrig),
                 style = sSide == 1 ? label.style_label_up : label.style_label_down, yloc = sSide == 1 ? yloc.belowbar : yloc.abovebar,
                 size = size.tiny, color = color.new(color.orange, 20), textcolor = color.black)
        alert("TCI SETUP " + (sSide == 1 ? "BUY" : "SELL") + ": " + sDetail + ". Enter if price crosses " + fmt(pTrig), alert.freq_once_per_bar_close)

// ---------------- trade lines: SL (red), T1 (green), MAX (light green) ----------------
inTrade = posSide != 0
justExited = not na(exitBar) and bar_index == exitBar
plot(inTrade ? posSL : justExited ? exitSL : na, "Stop-loss", color.new(#F23645, 0), 2, plot.style_linebr)
plot(inTrade and not t1Hit ? posT1 : justExited and not exitT1Hit ? exitT1 : na, "T1", color.new(#089981, 0), 2, plot.style_linebr)
plot(inTrade ? posMax : justExited ? exitMax : na, "MAX target", color.new(#089981, 50), 2, plot.style_linebr)
plot(ceWall > 0 ? ceWall : na, "CALL OI wall", color.new(color.red, 40), 1, plot.style_linebr)
plot(peWall > 0 ? peWall : na, "PUT OI wall", color.new(color.green, 40), 1, plot.style_linebr)

// ---------------- liquidity map: nearest untouched levels above and below, drawn into the future ----------------
var line[] mapLines = array.new_line()
var label[] mapLabels = array.new_label()
var string upTxt = ""
var string dnTxt = ""
var float upNear = na
var float dnNear = na
if barstate.islast
    if array.size(mapLines) > 0
        for i = 0 to array.size(mapLines) - 1
            line.delete(array.get(mapLines, i))
            label.delete(array.get(mapLabels, i))
    array.clear(mapLines)
    array.clear(mapLabels)
    cp = array.new_float()
    cn = array.new_string()
    if array.size(pP) > 0
        for i = 0 to array.size(pP) - 1
            array.push(cp, array.get(pP, i))
            array.push(cn, array.get(pN, i))
    sessionOver = barEnd >= toMin(1530)
    array.push(cp, curH)
    array.push(cn, sessionOver ? "last session high" : "day high")
    array.push(cp, curL)
    array.push(cn, sessionOver ? "last session low" : "day low")
    if ceWall > 0
        array.push(cp, ceWall)
        array.push(cn, "CALL OI wall")
    if peWall > 0
        array.push(cp, peWall)
        array.push(cn, "PUT OI wall")
    upTxt := ""
    dnTxt := ""
    upNear := na
    dnNear := na
    for s = 0 to 1
        // s = 0: above (buy-side liquidity), s = 1: below (sell-side liquidity)
        used = array.new_float()
        for j = 1 to math.max(mapCount, 1)
            float bestV = na
            for i = 0 to array.size(cp) - 1
                v = array.get(cp, i)
                ok = s == 0 ? v > close + 0.5 : v < close - 0.5
                dup = false
                if array.size(used) > 0
                    for u = 0 to array.size(used) - 1
                        if math.abs(array.get(used, u) - v) <= 3
                            dup := true
                if ok and not dup and (na(bestV) or (s == 0 ? v < bestV : v > bestV))
                    bestV := v
            if na(bestV)
                // not enough real levels on this side (e.g. at a fresh multi-day low): use the next round 100
                base = array.size(used) > 0 ? array.get(used, array.size(used) - 1) : close
                bestV := s == 0 ? (math.floor(base / 100) + 1) * 100 : (math.ceil(base / 100) - 1) * 100
            if not na(bestV)
                array.push(used, bestV)
                nm = ""
                for i = 0 to array.size(cp) - 1
                    if math.abs(array.get(cp, i) - bestV) <= 3
                        nm := nm == "" ? array.get(cn, i) : str.contains(nm, array.get(cn, i)) ? nm : nm + " + " + array.get(cn, i)
                nm := nm == "" ? "round number" : nm
                d = bestV - close
                piece = fmt(bestV) + " " + nm + " (" + str.tostring(d, "+#;-#") + ")"
                if s == 0
                    upTxt := upTxt == "" ? piece : upTxt + "\n" + piece
                    upNear := na(upNear) ? bestV : upNear
                else
                    dnTxt := dnTxt == "" ? piece : dnTxt + "\n" + piece
                    dnNear := na(dnNear) ? bestV : dnNear
                if j <= mapCount
                    col = s == 0 ? color.new(#F23645, 30) : color.new(#089981, 30)
                    ln = line.new(bar_index - 40, bestV, bar_index, bestV, extend = extend.right, color = col, style = line.style_dashed, width = 1)
                    lb = label.new(bar_index + 6, bestV, nm + "  " + fmt(bestV), style = label.style_label_left, size = size.small,
                         color = color.new(color.white, 100), textcolor = col)
                    array.push(mapLines, ln)
                    array.push(mapLabels, lb)

// ---------------- plan table ----------------
var table tb = table.new(position.top_right, 2, 7, bgcolor = color.new(color.white, 8), border_color = color.new(color.gray, 70), border_width = 1)
if showPlan and barstate.islast
    planTxt = (na(upNear) ? "" : "SELL if price runs above " + fmt(upNear) + " and a 5-min candle closes back below it.\n") + (na(dnNear) ? "" : "BUY if price runs below " + fmt(dnNear) + " and a 5-min candle closes back above it.\n") + "After a clean break, wait for the retest."
    tradeTxt = posSide != 0 ? (posSide == 1 ? "IN BUY " : "IN SELL ") + fmt(posEntry) + "  SL " + fmt(posSL) + (halfDone ? " (half booked)" : "") + "  T1 " + fmt(posT1) + (t1Hit ? " (hit)" : "") + "  MAX " + fmt(posMax) : pSide != 0 ? "Setup: " + pDetail + ". Enter beyond " + fmt(pTrig) : lastMsg
    ctxTxt = "Trend (5-min structure): " + (trend > 0 ? "UP" : trend < 0 ? "DOWN" : "-") + (pcrVal > 0 ? "   PCR " + str.tostring(pcrVal, "#.##") + (pcrVal >= 1.3 ? " (put writers: support)" : pcrVal <= 0.7 ? " (call writers: resistance)" : " (neutral)") : "   PCR: not set") + (tfMin != 5 ? "\nUSE THE 5-MINUTE CHART" : "")
    table.cell(tb, 0, 0, "Liquidity above", text_color = #F23645, text_size = size.small)
    table.cell(tb, 1, 0, upTxt == "" ? "-" : upTxt, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 0, 1, "Liquidity below", text_color = #089981, text_size = size.small)
    table.cell(tb, 1, 1, dnTxt == "" ? "-" : dnTxt, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 0, 2, "Plan", text_size = size.small)
    table.cell(tb, 1, 2, planTxt, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 0, 3, "Trade", text_size = size.small)
    table.cell(tb, 1, 3, tradeTxt, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 0, 4, "Context", text_size = size.small)
    table.cell(tb, 1, 4, ctxTxt, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 0, 5, "Today", text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(dayTrades) + " trades, " + str.tostring(dayLosses) + " losses" + (dayTrades >= maxTrades or dayLosses >= maxLosses ? "  -> DONE FOR THE DAY" : ""), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 0, 6, "Scorecard", text_size = size.small)
    table.cell(tb, 1, 6, nTrades == 0 ? "no closed trades on this chart yet" : str.tostring(nTrades) + " trades | win " + str.tostring(100.0 * nWins / nTrades, "#") + "% | total " + str.tostring(sumPts, "+#;-#") + " index pts (before costs)", text_size = size.small, text_halign = text.align_left)
