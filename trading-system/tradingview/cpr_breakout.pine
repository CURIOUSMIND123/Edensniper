// CPR Breakout for TradingView. Select and copy EVERYTHING in this file, including the next line.
//@version=5
// ============================================================================
// CPR Breakout: NIFTY or SENSEX, 5-MINUTE chart (1-minute data is read underneath for exits)
// Draws the CPR (orange = narrow), pivot, the first 15-minute candle's high / low, the 30-day volume point of
// control (POC: the price where the most volume traded; volume from NIFTYBEES because the index has none) with its
// value area, and the 5-minute EMA 50. Every filter is in Settings.
// DEFAULTS = DAILY PLAN (one plan per day), adjusted on 2026:
//   NARROW-CPR DAY -> CPR BREAKOUT scalp. OTHER DAY -> CPR MAGNET at 9:16 if the open qualifies, otherwise the
//   same CPR BREAKOUT scalp.
//   CPR Magnet: the 9:15 one-minute candle opens beyond the CPR and closes 0.2%+ beyond it -> trade back toward
//     the CPR at 9:16, stop 0.3% of price, book half at 0.25 x the risk, stop to entry, rest to the CPR edge.
//   CPR Breakout scalp: only in the direction of the opening gap; not against today's CPR vs yesterday's; only on
//     the volume side of the 30-day POC (buys above, sells below); BUY / SELL when price touches the first
//     15-minute candle's high / low, only before 10:00; stop at the other side of that range; book half at
//     0.25 x the risk, stop to entry, trail the rest 1R behind the best price after +1R; one reversal trade if the
//     first break loses (also before 10:00 and on the POC side).
//   Out by 3:15.
// Tested on 1-minute candles, 1 Jan - 9 Oct 2026 (191 sessions), after costs (4 Nifty / 12 Sensex points a trade):
//   Nifty  99 trades on 99 days (about 10 a month), 81 won / 18 lost, +2,197 / -1,280, net +917
//          (Jan-Jun +916, Jul-Oct +1). Breakout part: 27 won / 3 lost, +893. Magnet part: 56 won / 16 lost, +23.
//   Sensex 98 trades on 98 days, 85 won / 13 lost, +5,682 / -3,141, net +2,542 (Jan-Jun +1,026, Jul-Oct +1,516).
// MORE PROFIT, LOWER WIN RATE: switch off "Magnet: book half" (full target at the CPR edge):
//   Nifty 59 won / 40 lost, net +1,834. Sensex 60 won / 38 lost, net +5,514.
// The POC, 10:00 and every-day choices were made by looking at 2026 itself (each helped in both halves of the
//   year on both indices); treat them as promising, not proven.
// The profile here uses the chart's 5-minute candles; the test used 1-minute candles, so the POC can differ by a
//   few points.
// Reference implementation (same rules): trading-system/research/quant/y2026_daily.py (plan)
// ============================================================================
indicator("CPR Breakout", "CPRB", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 2500)

// ---------------- inputs ----------------
G1 = "Rules"
cprF   = input.string("Off", "Direction from the open vs the CPR", options = ["With the CPR", "Not against the CPR", "Off"], group = G1)
pocF   = input.string("Beyond the POC", "Volume zone filter (buys above the POC, sells below)", options = ["Off", "Beyond the POC", "Beyond the value area"], group = G1)
cutH   = input.int(10, "No new entries from (hour)", minval = 9, maxval = 15, group = G1)
cutMn  = input.int(0, "No new entries from (minute)", minval = 0, maxval = 59, group = G1)
emaF   = input.bool(false, "Only with the 5-minute EMA 50", group = G1)
relF   = input.bool(true, "Not against today's CPR vs yesterday's (higher / lower value)", group = G1)
widF   = input.string("Any", "CPR width (breakout trades)", options = ["Any", "Narrow only", "Skip narrow"], group = G1)
entF   = input.string("Touch of the range high / low", "Entry", options = ["5-minute close beyond the range", "Touch of the range high / low"], group = G1)
stopF  = input.string("Other side of the 15-minute range", "Stop", options = ["Other side of the 15-minute range", "Middle of the 15-minute range", "0.2% of price"], group = G1)
exitF  = input.string("Scalp: book half at 0.25R, stop to entry, trail the rest", "Exit", options = ["Scalp: book half at 0.25R, stop to entry, trail the rest", "Target 3 x risk", "Ride: stop to entry at +1R, out at 3:15", "Trail 1R behind the best price after +1R"], group = G1)
gapF   = input.bool(true, "Only in the direction of the opening gap (open vs yesterday's close)", group = G1)
revF   = input.bool(true, "Reversal trade when the first break fails", group = G1)
G4 = "CPR Magnet (one plan per day)"
magOn   = input.bool(true, "On days that are NOT narrow, trade CPR Magnet at 9:16 if the open qualifies (then no breakout that day)", group = G4)
magGap  = input.float(0.2, "Magnet: 9:15 candle closes at least this % beyond the CPR", step = 0.05, group = G4)
magStop = input.float(0.3, "Magnet: stop, % of price", step = 0.05, group = G4)
magHalf = input.bool(true, "Magnet: book half at 0.25 x the risk, stop to entry, rest to the CPR edge", group = G4)
costIn = input.float(0, "Cost per trade in index points (0 = auto: Nifty 4, Sensex 12)", step = 1, group = G1)
G2 = "Display"
showPrf = input.bool(true, "Show the volume POC and value area", group = G2)
G3 = "Volume zones"
volSym  = input.symbol("NSE:NIFTYBEES", "Volume from (the index has none; the test used NIFTYBEES for both indices)", group = G3)
profN   = input.int(30, "Volume profile: last N sessions", minval = 5, maxval = 30, group = G3)
showEma = input.bool(true, "Show the EMA 50", group = G2)
showBox = input.bool(true, "Show the status and results box", group = G2)

TZ     = "Asia/Kolkata"
GREEN  = color.new(#089981, 0)
RED    = color.new(#f23645, 0)
GREY   = color.new(#787b86, 0)
BLUE   = color.new(#2962ff, 0)
ORANGE = color.new(#f57c00, 0)
PURPLE = color.new(#7e57c2, 0)
fmt(x) => str.tostring(x, "#,##0.##")
pts(x) => str.tostring(x, "+#,##0;-#,##0")
minsOf(int t) => hour(t, TZ) * 60 + minute(t, TZ)
cost = costIn > 0 ? costIn : close > 50000 ? 12.0 : 4.0
BIN  = close > 50000 ? 16.0 : 5.0
CUT  = cutH * 60 + cutMn     // no new entries from this time
TOUT = 915     // out at 15:15

// ---------------- CPR: today's (from yesterday) and yesterday's (from the day before) ----------------
cprWidth(float h, float l, float c) =>
    float p = (h + l + c) / 3
    float bc = (h + l) / 2
    math.abs(2 * p - 2 * bc) / p * 100
dayInfo() =>
    float w = cprWidth(high[1], low[1], close[1])
    int narrower = 0
    for i = 1 to 20
        if w[i] < w
            narrower += 1
    [high[1], low[1], close[1], high[2], low[2], close[2], narrower]
[pH, pL, pC, qH, qL, qC, nNar] = request.security(syminfo.tickerid, "D", dayInfo(), lookahead = barmerge.lookahead_on)
P   = (pH + pL + pC) / 3
BC  = (pH + pL) / 2
top = math.max(2 * P - BC, BC)
bot = math.min(2 * P - BC, BC)
yP  = (qH + qL + qC) / 3
yBC = (qH + qL) / 2
yTop = math.max(2 * yP - yBC, yBC)
yBot = math.min(2 * yP - yBC, yBC)
narrow  = nNar * 3 < 20
relBias = bot > yTop ? 1 : top < yBot ? -1 : 0
widOk   = widF == "Any" or (widF == "Narrow only") == narrow

ema50  = ta.ema(close, 50)
mins   = minsOf(time)
newDay = dayofmonth(time, TZ) != dayofmonth(time[1], TZ)
lc(color col) => newDay ? na : col
is5 = timeframe.isintraday and timeframe.multiplier == 5

// ---------------- volume profile of the last N sessions (bars before today) ----------------
// NIFTYBEES volume spread over each index candle's range; time at price if that volume isn't available
bv = request.security(volSym, timeframe.period, volume, lookahead = barmerge.lookahead_off)
float vw = na(bv) or bv <= 0 ? 1.0 : bv
var int[] dStart = array.new_int()
var float poc = na
var float vah = na
var float val = na
if newDay and is5
    n = array.size(dStart)
    if n >= profN
        first = array.get(dStart, n - profN)
        nb = bar_index - first
        if nb > 10 and nb < 2450
            float lo0 = low[1]
            float hi0 = high[1]
            for i = 1 to nb
                lo0 := math.min(lo0, low[i])
                hi0 := math.max(hi0, high[i])
            lo0 := math.floor(lo0 / BIN) * BIN
            nbin = int((hi0 - lo0) / BIN) + 2
            if nbin < 3000
                float[] hist = array.new_float(nbin, 0.0)
                for i = 1 to nb
                    a = int((low[i] - lo0) / BIN)
                    z = int((high[i] - lo0) / BIN)
                    float share = vw[i] / (z - a + 1)
                    for b = a to z
                        array.set(hist, b, array.get(hist, b) + share)
                k = array.indexof(hist, array.max(hist))
                tot = array.sum(hist)
                int a2 = k
                int b2 = k
                float s = array.get(hist, k)
                while s < 0.7 * tot
                    float up = b2 + 1 < nbin ? array.get(hist, b2 + 1) : -1.0
                    float dn = a2 > 0 ? array.get(hist, a2 - 1) : -1.0
                    if up < 0 and dn < 0
                        break
                    if up >= dn
                        b2 += 1
                        s += up
                    else
                        a2 -= 1
                        s += dn
                poc := lo0 + (k + 0.5) * BIN
                vah := lo0 + (b2 + 1) * BIN
                val := lo0 + a2 * BIN
    array.push(dStart, bar_index)
    if array.size(dStart) > 31
        array.shift(dStart)

// ---------------- plots ----------------
cprCol = narrow ? ORANGE : BLUE
pTop = plot(is5 ? top : na, "CPR top", color = lc(cprCol), linewidth = 2)
pBot = plot(is5 ? bot : na, "CPR bottom", color = lc(cprCol), linewidth = 2)
plot(is5 ? P : na, "Pivot P", color = lc(color.new(cprCol, 40)))
fill(pTop, pBot, color = newDay ? na : color.new(cprCol, 82), title = "CPR band (orange = narrow)")
plot(is5 and showPrf ? poc : na, "Volume POC", color = lc(PURPLE), linewidth = 2, style = plot.style_linebr)
plot(is5 and showPrf ? vah : na, "Value area high", color = lc(color.new(PURPLE, 60)), style = plot.style_linebr)
plot(is5 and showPrf ? val : na, "Value area low", color = lc(color.new(PURPLE, 60)), style = plot.style_linebr)
plot(is5 and showEma ? ema50 : na, "EMA 50", color = color.new(GREY, 30))

// ---------------- the 15-minute range and the trades ----------------
[o1, h1, l1, c1, t1] = request.security_lower_tf(syminfo.tickerid, "1", [open, high, low, close, time])

var float orh = na
var float orl = na
var int   cb = 0            // +1 opened above the CPR, -1 below, 0 inside
var int   state = 0         // 0 waiting, 1 in a trade, 2 waiting for the reversal break, 3 done for today
var int   side = 0
var int   tradeNo = 0
var int   afterMin = 0
var int   startMin = 0
var float e = na
var float stp = na
var float tgt = na
var float R = na
var float best = na
var bool  halfDone = false
var float halfPts = na
var int   gapDir = 0           // +1 opened above yesterday's close, -1 below
var bool  isMag = false        // today's trade is a CPR Magnet trade
var float tgt2 = na            // magnet: final target (the CPR edge)
var line  lnS = na
var line  lnT = na
var string todayMsg = ""
var int   nTr = 0
var int   nWon = 0
var float totPts = 0.0
var float winPts = 0.0
var float lossPts = 0.0

pocPass(int sd, float px) =>
    bool ok = true
    if pocF != "Off"
        float ref = pocF == "Beyond the POC" ? poc : (sd > 0 ? vah : val)
        if na(ref) or sd * (px - ref) <= 0
            ok := false
    ok

passes(int sd, float px, float emaNow) =>
    bool ok = widOk
    if cprF == "With the CPR" and sd != cb
        ok := false
    if cprF == "Not against the CPR" and sd == -cb
        ok := false
    if relF and sd == -relBias
        ok := false
    if gapF and sd != gapDir
        ok := false
    if emaF and sd * (px - emaNow) <= 0
        ok := false
    if pocF != "Off"
        float ref = pocF == "Beyond the POC" ? poc : (sd > 0 ? vah : val)
        if na(ref) or sd * (px - ref) <= 0
            ok := false
    ok

stopFor(int sd, float px) =>
    stopF == "Other side of the 15-minute range" ? (sd > 0 ? orl : orh) : stopF == "Middle of the 15-minute range" ? (orh + orl) / 2 : px - sd * 0.002 * px

halfMode = exitF == "Scalp: book half at 0.25R, stop to entry, trail the rest"
tgtFor(int sd, float px, float r) =>
    exitF == "Target 3 x risk" ? px + sd * 3 * r : halfMode ? px + sd * 0.25 * r : na

if newDay
    orh := na
    orl := na
    state := 0
    tradeNo := 0
    cb := 0
    isMag := false
    todayMsg := not widOk ? "No trade: CPR width filter" : "Building the 15-minute range"

// a trade is opened by setting these, then drawn once below
bool opened = false
int  openSide = 0
float openPx = na

n1 = array.size(c1)
if is5 and n1 > 0
    for k = 0 to n1 - 1
        mk = minsOf(array.get(t1, k))
        ok = array.get(o1, k)
        hk = array.get(h1, k)
        lk = array.get(l1, k)
        ck = array.get(c1, k)
        complete = k < n1 - 1 or barstate.isconfirmed
        if mk == 555
            cb := ok > top ? 1 : ok < bot ? -1 : 0
            gapDir := ok > pC ? 1 : ok < pC ? -1 : 0
            if magOn and not narrow and state == 0 and complete
                int ms = ok > top and ck >= top / (1 - magGap / 100) ? -1 : ok < bot and ck <= bot / (1 + magGap / 100) ? 1 : 0
                if ms != 0
                    opened := true
                    openSide := ms
                    openPx := ck
                    side := ms
                    e := ck
                    R := magStop / 100 * ck
                    stp := ck - ms * R
                    tgt2 := ms < 0 ? top : bot
                    tgt := magHalf ? ck + ms * 0.25 * R : tgt2
                    halfDone := false
                    halfPts := na
                    best := ck
                    startMin := 556
                    tradeNo := 1
                    isMag := true
                    state := 1
        if mk < 570
            orh := na(orh) ? hk : math.max(orh, hk)
            orl := na(orl) ? lk : math.min(orl, lk)
        // exits
        if state == 1 and mk >= startMin
            // order of prices inside a 1-minute candle: green open-low-high-close, red open-high-low-close
            float a1 = ck >= ok ? lk : hk
            float a2 = ck >= ok ? hk : lk
            bool isOut = false
            float ex = na
            string why = ""
            for j = 0 to 3
                float q = j == 0 ? ok : j == 1 ? a1 : j == 2 ? a2 : ck
                if not isOut
                    if side * (q - stp) <= 0
                        isOut := true
                        ex := stp
                        why := side * (stp - e) > 0 ? "TRAIL STOP" : stp == e ? "STOP AT ENTRY" : "STOP"
                    else if not na(tgt) and side * (q - tgt) >= 0
                        if (isMag ? magHalf : halfMode) and not halfDone
                            halfDone := true
                            halfPts := side * (tgt - e)
                            if side * (e - stp) > 0
                                stp := e
                            label.new(bar_index, tgt, "HALF BOOKED +" + str.tostring(halfPts, "#,##0"), style = label.style_label_left, color = color.new(GREEN, 80), textcolor = GREEN, size = size.tiny)
                            alert("CPRB " + syminfo.ticker + " BOOK HALF at " + fmt(tgt) + ", move stop to " + fmt(stp), alert.freq_once_per_bar)
                            tgt := na
                        else
                            isOut := true
                            ex := tgt
                            why := "TARGET"
            if not isOut
                best := side > 0 ? math.max(best, hk) : math.min(best, lk)
                if not isMag and exitF == "Ride: stop to entry at +1R, out at 3:15" and side * (best - e) >= R and side * (e - stp) > 0
                    stp := e
                if not isMag and (exitF == "Trail 1R behind the best price after +1R" or halfMode) and side * (best - e) >= R
                    float ns = best - side * R
                    if side * (ns - stp) > 0
                        stp := ns
                if mk >= TOUT and complete
                    isOut := true
                    ex := ck
                    why := "3:15 EXIT"
            if isOut
                float g = (halfDone ? (halfPts + side * (ex - e)) / 2 : side * (ex - e)) - cost
                nTr += 1
                nWon += g > 0 ? 1 : 0
                totPts += g
                winPts += g > 0 ? g : 0
                lossPts += g > 0 ? 0 : g
                label.new(bar_index, ex, why + " " + pts(g) + " pts", style = label.style_label_left, color = color.new(g > 0 ? GREEN : RED, 80), textcolor = g > 0 ? GREEN : RED, size = size.small)
                line.set_extend(lnT, extend.none)
                line.set_extend(lnS, extend.none)
                line.set_x2(lnT, bar_index)
                line.set_x2(lnS, bar_index)
                todayMsg := why + " at " + fmt(ex) + ": " + pts(g) + " pts after costs" + (halfDone ? " (half booked earlier)" : "")
                alert("CPRB " + syminfo.ticker + " " + why + " at " + fmt(ex) + " (" + pts(g) + " pts after costs)", alert.freq_once_per_bar)
                if tradeNo == 1 and g <= 0 and revF and not isMag
                    state := 2
                    afterMin := mk + 1
                else
                    state := 3
        // touch entries
        if mk >= 570 and entF == "Touch of the range high / low" and mk < CUT and not na(orh) and (state == 0 or (state == 2 and mk >= afterMin))
            int sd = hk >= orh ? 1 : lk <= orl ? -1 : 0
            if state == 2 and sd != -side
                sd := 0
            if sd != 0
                float px = sd > 0 ? math.max(ok, orh) : math.min(ok, orl)
                if state == 2 ? pocPass(sd, px) : passes(sd, px, ema50[1])
                    float s0 = stopFor(sd, px)
                    if sd * (px - s0) > 0
                        opened := true
                        openSide := sd
                        openPx := px
                        side := sd
                        e := px
                        stp := s0
                        R := sd * (px - s0)
                        tgt := tgtFor(sd, px, R)
                        halfDone := false
                        halfPts := na
                        best := px
                        startMin := mk + 1
                        tradeNo += 1
                        state := 1

// 5-minute close entries (at the close of this candle)
if is5 and entF == "5-minute close beyond the range" and barstate.isconfirmed and not na(orh) and mins >= 570 and mins + 5 <= CUT and (state == 0 or (state == 2 and mins >= afterMin))
    int sd = close > orh ? 1 : close < orl ? -1 : 0
    if state == 2 and sd != -side
        sd := 0
    if sd != 0
        if state == 2 ? pocPass(sd, close) : passes(sd, close, ema50)
            float s0 = stopFor(sd, close)
            if sd * (close - s0) > 0
                opened := true
                openSide := sd
                openPx := close
                side := sd
                e := close
                stp := s0
                R := sd * (close - s0)
                tgt := tgtFor(sd, close, R)
                halfDone := false
                halfPts := na
                best := close
                startMin := mins + 5
                tradeNo += 1
                state := 1

if opened
    float t0 = isMag ? tgt : tgtFor(openSide, openPx, R)
    string tTxt = isMag ? (magHalf ? "book half at " + fmt(t0) + ", rest to CPR " + fmt(tgt2) : "target CPR " + fmt(tgt2)) : na(t0) ? "ride / trail" : halfMode ? "book half at " + fmt(t0) : "target " + fmt(t0)
    txt = (isMag ? "MAGNET " : "") + (openSide > 0 ? "BUY " : "SELL ") + fmt(openPx) + (tradeNo == 2 ? " (reversal)" : "") + "\nstop " + fmt(stp) + "\n" + tTxt
    label.new(bar_index, openPx, txt, style = openSide > 0 ? label.style_label_up : label.style_label_down, color = openSide > 0 ? GREEN : RED, textcolor = color.white, size = size.small)
    lnS := line.new(bar_index, stp, bar_index + 1, stp, color = RED, style = line.style_dashed, extend = extend.right)
    lnT := line.new(bar_index, na(t0) ? openPx : t0, bar_index + 1, na(t0) ? openPx : t0, color = na(t0) ? GREY : GREEN, style = line.style_dashed, extend = extend.right)
    todayMsg := (openSide > 0 ? "BUY at " : "SELL at ") + fmt(openPx) + ", stop " + fmt(stp) + ", " + tTxt
    alert("CPRB " + syminfo.ticker + (openSide > 0 ? " BUY at " : " SELL at ") + fmt(openPx) + " | STOP " + fmt(stp) + " | " + tTxt, alert.freq_once_per_bar)

plot(is5 and mins >= 570 ? orh : na, "15-min high", color = lc(color.new(GREEN, 30)), style = plot.style_linebr)
plot(is5 and mins >= 570 ? orl : na, "15-min low", color = lc(color.new(RED, 30)), style = plot.style_linebr)

// ---------------- status and results box ----------------
var table tbl = table.new(position.top_right, 2, 8, bgcolor = color.new(chart.bg_color, 5), border_width = 1, border_color = color.new(GREY, 60), frame_width = 1, frame_color = GREY)
cell(int r, string a, string b, color tc) =>
    table.cell(tbl, 0, r, a, text_color = GREY, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, r, b, text_color = tc, text_size = size.small, text_halign = text.align_left)
if barstate.islast and showBox
    bias = cprF == "Off" ? "both ways" : cb > 0 ? "opened above the CPR: buys" : cb < 0 ? "opened below the CPR: sells" : (cprF == "With the CPR" ? "opened inside the CPR: no trade" : "opened inside: both ways")
    cell(0, "CPR Breakout", is5 ? syminfo.ticker : "Use a 5-minute chart", is5 ? chart.fg_color : RED)
    cell(1, "Today's CPR", fmt(bot) + " - " + fmt(top) + (narrow ? " (narrow)" : ""), chart.fg_color)
    cell(2, "Bias", bias, cb > 0 ? GREEN : cb < 0 ? RED : chart.fg_color)
    cell(3, "15-minute range", na(orh) ? "-" : fmt(orl) + " - " + fmt(orh), chart.fg_color)
    cell(4, str.tostring(profN) + "-day volume POC / value area", na(poc) ? "-" : fmt(poc) + " / " + fmt(val) + " - " + fmt(vah), PURPLE)
    cell(5, "Today", todayMsg, chart.fg_color)
    cell(6, "On this chart", str.tostring(nTr) + " trades, " + str.tostring(nWon) + " won, " + str.tostring(nTr - nWon) + " lost", chart.fg_color)
    cell(7, "Points won / lost / net", pts(winPts) + " / " + pts(lossPts) + " / " + pts(totPts), totPts >= 0 ? GREEN : RED)
